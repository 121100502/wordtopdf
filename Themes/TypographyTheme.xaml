<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ==================== 字体规范 ==================== -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, 微软雅黑, 宋体, sans-serif</FontFamily>

    <!-- 文字尺寸 -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubhead">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeHeadline">24</sys:Double>

    <!-- ==================== 圆角规范（大圆角胶囊风） ==================== -->
    <CornerRadius x:Key="CardCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="TagCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

    <!-- ==================== 间距规范 ==================== -->
    <sys:Double x:Key="SpacingXS">4</sys:Double>
    <sys:Double x:Key="SpacingSM">8</sys:Double>
    <sys:Double x:Key="SpacingMD">12</sys:Double>
    <sys:Double x:Key="SpacingLG">16</sys:Double>
    <sys:Double x:Key="SpacingXL">24</sys:Double>
    <sys:Double x:Key="SpacingXXL">32</sys:Double>

    <Thickness x:Key="CardPadding">24</Thickness>
    <Thickness x:Key="CardMargin">8</Thickness>
    <Thickness x:Key="ControlPadding">24,12</Thickness>

</ResourceDictionary>
