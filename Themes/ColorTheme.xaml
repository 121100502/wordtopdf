<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 配色体系 - 紫蓝科技风 ==================== -->
    <!-- 主色（品牌蓝紫） -->
    <Color x:Key="PrimaryColor">#FF5B6DFF</Color>
    <Color x:Key="PrimaryHoverColor">#FF7A8AFF</Color>
    <Color x:Key="PrimaryPressedColor">#FF4558E6</Color>
    <Color x:Key="PrimaryLightColor">#FFEBEEFF</Color>
    <Color x:Key="PrimaryLighterColor">#FFF5F6FF</Color>

    <!-- 功能色 -->
    <Color x:Key="SuccessColor">#FF22C55E</Color>
    <Color x:Key="SuccessLightColor">#FFDCFCE7</Color>
    <Color x:Key="WarningColor">#FFF59E0B</Color>
    <Color x:Key="WarningLightColor">#FFFEF3C7</Color>
    <Color x:Key="ErrorColor">#FFEF4444</Color>
    <Color x:Key="ErrorLightColor">#FFFEE2E2</Color>

    <!-- 中性色 -->
    <Color x:Key="TextPrimaryColor">#FF1F2937</Color>
    <Color x:Key="TextSecondaryColor">#FF4B5563</Color>
    <Color x:Key="TextTertiaryColor">#FF9CA3AF</Color>
    <Color x:Key="TextQuaternaryColor">#FFD1D5DB</Color>
    <Color x:Key="BorderColor">#FFE5E7EB</Color>
    <Color x:Key="BorderHoverColor">#FFD1D5DB</Color>
    <Color x:Key="DividerColor">#FFF3F4F6</Color>
    <Color x:Key="PageBackgroundColor">#FFF8F9FC</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="DisableBgColor">#FFF3F4F6</Color>
    <Color x:Key="DisableTextColor">#FFD1D5DB</Color>

    <!-- 纯色 Brush -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryLighterBrush" Color="{StaticResource PrimaryLighterColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource ErrorLightColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextQuaternaryBrush" Color="{StaticResource TextQuaternaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="DisableBgBrush" Color="{StaticResource DisableBgColor}" />
    <SolidColorBrush x:Key="DisableTextBrush" Color="{StaticResource DisableTextColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFFFF" />

    <!-- 渐变画笔 -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6B7DFF" Offset="0" />
        <GradientStop Color="#FF4B5FE6" Offset="1" />
    </LinearGradientBrush>

    <!-- 阴影 -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="#5B6DFF"
                      Opacity="0.08"
                      BlurRadius="24"
                      ShadowDepth="0"
                      Direction="270" />

    <DropShadowEffect x:Key="CardHoverShadowEffect"
                      Color="#5B6DFF"
                      Opacity="0.15"
                      BlurRadius="32"
                      ShadowDepth="0"
                      Direction="270" />

    <DropShadowEffect x:Key="PrimaryButtonShadow"
                      Color="#5B6DFF"
                      Opacity="0.35"
                      BlurRadius="16"
                      ShadowDepth="0"
                      Direction="270" />

    <DropShadowEffect x:Key="WindowShadowEffect"
                      Color="#000000"
                      Opacity="0.12"
                      BlurRadius="32"
                      ShadowDepth="4"
                      Direction="270" />

</ResourceDictionary>
