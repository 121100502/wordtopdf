<Window x:Class="WordToPdfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:WordToPdfApp.ViewModels"
        xmlns:helpers="clr-namespace:WordToPdfApp.Helpers"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:WordToPdfApp"
        mc:Ignorable="d"
        Title="Word 转 PDF 批量工具"
        Height="720"
        Width="1180"
        MinHeight="620"
        MinWidth="980"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        DataContext="{Binding Source={x:Static helpers:ViewModelLocator.Main}}"
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      CornerRadius="28"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="8"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource PageBackgroundBrush}"
            CornerRadius="28"
            Effect="{StaticResource WindowShadowEffect}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==================== 顶部标题栏 ==================== -->
            <Grid Grid.Row="0"
                  x:Name="TitleBar"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：红黄绿圆点 + 标题 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="24,0,0,0">
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FFEF4444" Margin="0,0,8,0" Cursor="Hand" ToolTip="关闭"
                            MouseLeftButtonDown="CloseButton_Click" />
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FFF59E0B" Margin="0,0,8,0" Cursor="Hand" ToolTip="最小化"
                            MouseLeftButtonDown="MinimizeButton_Click" />
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FF22C55E" Margin="0,0,24,0" Cursor="Hand" ToolTip="最大化" />

                    <TextBlock Text="Word 转 PDF 批量工具"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 右：消息/设置/最小化/关闭 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="💬"
                            FontSize="18"
                            ToolTip="消息通知"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="⚙"
                            FontSize="18"
                            ToolTip="设置"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="—"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="MinimizeButton_Click"
                            ToolTip="最小化"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="✕"
                            FontSize="14"
                            FontWeight="Bold"
                            Click="CloseButton_Click"
                            ToolTip="关闭"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ==================== 主内容区 ==================== -->
            <Grid Grid.Row="1"
                  Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- ========== 左栏：拖拽区 ========== -->
                <Grid Grid.Column="0" VerticalAlignment="Stretch">
                    <Border Style="{StaticResource CardContainerStyle}"
                            Padding="0"
                            CornerRadius="24"
                            Background="Transparent">
                        <Grid Margin="8">
                            <!-- 背景层 -->
                            <Border x:Name="DragBg"
                                    Background="{StaticResource PrimaryLighterBrush}"
                                    CornerRadius="20" />
                            <!-- 虚线边框层 -->
                            <Rectangle Stroke="{StaticResource PrimaryBrush}"
                                       StrokeThickness="2"
                                       StrokeDashArray="8,5"
                                       RadiusX="20"
                                       RadiusY="20"
                                       IsHitTestVisible="False"
                                       SnapsToDevicePixels="True" />
                            <!-- 内容层（接收拖拽） -->
                            <Border x:Name="DragDropBorder"
                                    Background="Transparent"
                                    CornerRadius="20"
                                    AllowDrop="True"
                                    Drop="DragZone_Drop"
                                    DragEnter="DragZone_DragEnter"
                                    DragLeave="DragZone_DragLeave"
                                    Padding="16">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- 图标 -->
                                    <Grid Width="140" Height="140" HorizontalAlignment="Center" Margin="0,0,0,24">
                                        <Ellipse Fill="{StaticResource PrimaryLightBrush}" Width="140" Height="140" />
                                        <Ellipse Fill="{StaticResource WhiteBrush}" Width="110" Height="110" />
                                        <TextBlock Text="📄" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 文字 -->
                                    <TextBlock Text="拖拽 Word"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="文件或文件夹到此处"
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,0,0,28" />

                                    <!-- 选择文件按钮 -->
                                    <Button Content="选择文件"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SelectFilesCommand}"
                                            Margin="0,0,0,12"
                                            HorizontalContentAlignment="Center"
                                            Width="200" />

                                    <!-- 选择文件夹按钮 -->
                                    <Button Content="选择文件夹"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding SelectFolderCommand}"
                                            HorizontalContentAlignment="Center"
                                            Width="200" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========== 中栏：文件列表 ========== -->
                <Grid Grid.Column="1" Margin="16,0,16,0">
                    <Border Style="{StaticResource CardContainerStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 列表表头 -->
                            <Border Grid.Row="0"
                                  Background="{StaticResource PrimaryLighterBrush}"
                                  CornerRadius="20,20,0,0"
                                  Height="52">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsAllSelected}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Cursor="Hand"
                                              Style="{StaticResource FigmaCheckBoxStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="文件名"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="状态"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="大小"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4"
                                               Text="操作"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 列表主体 -->
                            <ListBox Grid.Row="1"
                                     x:Name="FileListView"
                                     ItemsSource="{Binding FileList}"
                                     SelectedItem="{Binding SelectedFile}"
                                     ItemContainerStyle="{StaticResource ListItemContainerStyle}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Padding="8,8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="44" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 勾选框 -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Cursor="Hand"
                                                      Style="{StaticResource FigmaCheckBoxStyle}" />

                                            <!-- 文件名 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FileName}" />
                                            </StackPanel>

                                            <!-- 状态标签 -->
                                            <Border Grid.Column="2">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusTagStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Background" Value="{StaticResource ErrorLightBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Converting">
                                                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                <Setter Property="Background" Value="{StaticResource DividerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusTagTextStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                    <Setter Property="Text" Value="成功" />
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Text" Value="失败" />
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Converting">
                                                                    <Setter Property="Text" Value="转换中" />
                                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                    <Setter Property="Text" Value="已跳过" />
                                                                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- 大小 -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding SizeDisplay}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />

                                            <!-- 操作 -->
                                            <Button Grid.Column="4"
                                                    Content="✕"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    FontSize="12"
                                                    Padding="8,2"
                                                    MinHeight="24"
                                                    Foreground="{StaticResource ErrorBrush}"
                                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="移除"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 空状态提示 -->
                            <Border Grid.Row="1"
                                    x:Name="EmptyState"
                                    Background="Transparent"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="📂"
                                               FontSize="48"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="暂无文件"
                                               FontSize="14"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="拖拽 Word 文件到左侧，或点击选择文件"
                                               FontSize="12"
                                               Foreground="{StaticResource TextQuaternaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 统计栏 -->
                            <Grid Grid.Row="2"
                                  Height="48"
                                  Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="总计："
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalCount}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text=" 个文件"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="成功："
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SuccessCount}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="   失败："
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FailedCount}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ErrorBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- 进度条 -->
                            <Grid Grid.Row="3"
                                  Margin="16,0,16,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="转换进度"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TotalProgress, StringFormat='{}{0:F0}%'}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- 进度条（纯自定义，绕开 HandyControl 样式） -->
                                <Grid x:Name="ProgressTrack" Grid.Row="1" Height="16">
                                    <Border Background="{StaticResource DividerBrush}"
                                            CornerRadius="8" />
                                    <Border HorizontalAlignment="Left"
                                            CornerRadius="8"
                                            Background="{StaticResource PrimaryGradientBrush}">
                                        <Border.Width>
                                            <MultiBinding Converter="{x:Static local:PercentToWidthConverter.Instance}">
                                                <Binding ElementName="ProgressTrack" Path="ActualWidth" />
                                                <Binding Path="TotalProgress" />
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========== 右栏：设置面板 ========== -->
                <Grid Grid.Column="2" VerticalAlignment="Top">
                    <Border Style="{StaticResource CardContainerStyle}" Padding="20">
                        <StackPanel>
                            <!-- 输出目录标题 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="输出目录"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="▼"
                                           FontSize="12"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- 输出目录值（点击可选择） -->
                            <Border Background="{StaticResource PrimaryLighterBrush}"
                                    CornerRadius="12"
                                    Padding="16,12"
                                    Margin="0,0,0,20"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OutputDir_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding OutputDirectoryDisplay}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding OutputDirectoryDisplay}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="📁"
                                               FontSize="14"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 递归子文件夹开关 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="递归子文件夹"
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1"
                                              x:Name="ToggleRecursive"
                                              IsChecked="{Binding IsRecursive}"
                                              Style="{StaticResource FigmaToggleSwitchStyle}" />
                            </Grid>

                            <!-- 保留来源文件名开关 -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="保留来源文件名"
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1"
                                              x:Name="ToggleKeepName"
                                              IsChecked="{Binding KeepSourceFileName}"
                                              Style="{StaticResource FigmaToggleSwitchStyle}" />
                            </Grid>

                            <!-- 分隔线 -->
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,20" />

                            <!-- 开始转换按钮 -->
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding StartConvertCommand}"
                                    IsEnabled="{Binding CanConvert}"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Height="56"
                                    Margin="0,0,0,12">
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="开始转换" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                                    <Setter Property="Text" Value="转换中..." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- 隐私提示 -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0">
                                <TextBlock Text="🔒" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="本地转换，文件不上传"
                                           FontSize="12"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- 窗口内通知气泡 -->
            <hc:Growl x:Name="WindowGrowl"
                      Token="MainWindowGrowl"
                      Grid.RowSpan="2"
                      VerticalAlignment="Top"
                      Margin="0,72,0,0"
                      HorizontalAlignment="Center"
                      Panel.ZIndex="999"
                      ShowDateTime="False"
                      Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
