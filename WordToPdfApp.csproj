<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon />
    <RootNamespace>WordToPdfApp</RootNamespace>
    <AssemblyName>轻文Word批量转PDF</AssemblyName>
    <Version>1.0.0</Version>

    <!-- 单文件发布配置 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF UI 控件库 - MIT 协议，免费商用 -->
    <PackageReference Include="HandyControl" Version="3.5.0" />

    <!-- Word 文档操作 - 社区免费商用，支持 doc/docx -->
    <PackageReference Include="Syncfusion.DocIO.Net.Core" Version="24.2.9" />

    <!-- Word 渲染为 PDF -->
    <PackageReference Include="Syncfusion.DocIORenderer.Net.Core" Version="24.2.9" />

    <!-- MVVM 基础库 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

</Project>
